@model List<inizio.Models.GoogleSite>

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>

	<form method="get" asp-action="Index">
        <input type="text" name="SearchText" class="form-control" placeholder="Type something..." />
	    <button class="btn btn-primary mt-2">Search</button>
    </form>

    <button id="DownloadJsonButton" class="btn btn-primary mt-2">Download Json</button>

    @if (Model != null && Model.Count > 0)
    {
        @foreach (var item in Model)
        {
            <div class="card mt-3">
                <div class="card-body">
			        <h5 class="card-title">@item.Title</h5>
                    <p class="card-text">@item.Snippet</p>
			        <a href="@item.Link" class="btn btn-primary">Go to website</a>
                </div>
            </div>
        }
    }
</div>